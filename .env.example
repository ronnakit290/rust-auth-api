# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Everything here is read by src/config.rs.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development
APP_NAME=rust-auth-api
HOST=127.0.0.1
PORT=8080

# SQLite path. Use `sqlite::memory:` in tests. Relative paths resolve to the
# process working directory; the parent folder is created automatically.
DATABASE_URL=sqlite://./data/auth.db?mode=rwc
DB_MAX_CONNECTIONS=10

# At least 32 characters. Required when APP_ENV=production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_ISSUER=rust-auth-api
JWT_AUDIENCE=rust-auth-api-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MFA_TOKEN_TTL_SECONDS=300
JWT_LEEWAY_SECONDS=5

# Login hardening
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
REQUIRE_EMAIL_VERIFICATION=false
VERIFY_SESSION_ON_REQUEST=true

# Rate limiting (per IP, fixed window)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
RESET_RATE_LIMIT=5
RESET_RATE_WINDOW_SECONDS=3600
GLOBAL_RATE_LIMIT=300
GLOBAL_RATE_WINDOW_SECONDS=60

# console = log + in-memory outbox (dev), disabled = drop
EMAIL_MODE=console
EMAIL_FROM=no-reply@localhost
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Comma separated. Use * to allow any origin (no credentials support).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
SWAGGER_ENABLED=true

# Optional: created on start-up if the address does not exist yet.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# BOOTSTRAP_ADMIN_NAME=Platform Admin

# RUST_LOG=info,rust_auth_api=debug,sqlx=warn

# ---------------------------------------------------------------------------
# Central SSO (OAuth2) — lets other systems authenticate against this server
# ---------------------------------------------------------------------------
SSO_ENABLED=true
# Public base URL of this server. Used as `iss` and in the discovery document.
SSO_ISSUER=http://127.0.0.1:8080
# RS256 signing key (PKCS#8 PEM). Generate once and keep it secret:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out sso.pem
# Paste it here as ONE line with literal \n escapes, or leave empty for an
# ephemeral key (development only: every restart invalidates issued tokens).
# SSO_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
SSO_ACCESS_TTL_SECONDS=3600
SSO_CODE_TTL_SECONDS=300
SSO_REFRESH_TTL_SECONDS=2592000
APP_KEY_PREFIX=ssok
